NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://pms:CHANGE_ME@localhost:5434/pms
REDIS_URL=redis://localhost:6381
JWT_ACTIVE_KID=primary
JWT_KEYS={"primary":"REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"}
JWT_ISSUER=pms
JWT_AUDIENCE=pms-clients
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
IDENTITY_HASH_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
TRUSTED_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost
PUBLIC_WEB_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
REFRESH_DAYS=14
SESSION_DAYS=30
COOKIE_SECURE=false
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Backend origin, without /api/v1. Use the public HTTPS API origin on your VPS.
PUBLIC_API_URL=http://localhost:4000
# Optional: only used when STORAGE_DRIVER=s3 (also used by integration tests).
S3_ENDPOINT=http://localhost:9002
S3_PUBLIC_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=pms-private
S3_ACCESS_KEY=pms-local
S3_SECRET_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=pms@localhost.test
SMTP_SECURE=false
# Local Docker uses Mailpit; remove this override when using a real SMTP provider.
SMTP_DOCKER_HOST=mail
# Production: set SMTP_HOST, SMTP_PORT, SMTP_FROM, SMTP_USER and SMTP_PASSWORD.
# Port 587: SMTP_SECURE=false (STARTTLS); port 465: SMTP_SECURE=true.
# SMTP_USER=
# SMTP_PASSWORD=
MIN_CLIENT_VERSION=1.0.0
# Optional adapters must accept authenticated JSON POST requests over HTTPS.
# SMS_WEBHOOK_URL=
# PUSH_WEBHOOK_URL=
# PROVIDER_TOKEN=
# MALWARE_SCAN_URL=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
